# --- BullMQ / Redis (shared by API + worker) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
BULLMQ_PREFIX=eficyent
BULLMQ_DEFAULT_ATTEMPTS=3
BULLMQ_DEFAULT_BACKOFF_MS=5000

# --- Worker fleet concurrency (npm run worker) ---
# Each queue's worker reads its own key; missing keys fall back to 1.
WORKER_PAYOUT_CONCURRENCY=5
WORKER_BULK_PAYOUT_CONCURRENCY=2
WORKER_DEPOSIT_CONCURRENCY=3
WORKER_COMPLIANCE_CONCURRENCY=1
WORKER_REMITTANCE_CONCURRENCY=1
WORKER_BENEFICIARY_VALIDATION_CONCURRENCY=2
WORKER_FX_RATES_CONCURRENCY=1
WORKER_CALLBACK_CONCURRENCY=5
WORKER_DEBIT_NOTIFICATION_CONCURRENCY=2
WORKER_CALIZA_WEBHOOK_CONCURRENCY=2
WORKER_DIGININE_WEBHOOK_CONCURRENCY=2
