# --- BullMQ / Redis (shared by API + worker) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
BULLMQ_PREFIX=eficyent
BULLMQ_DEFAULT_ATTEMPTS=3
BULLMQ_DEFAULT_BACKOFF_MS=5000

# --- Queue worker (npm run worker — the queue:work equivalent) ---
# All jobs ride one core queue; the centralized worker routes by job name.
QUEUE_NAME=default
QUEUE_CONCURRENCY=5

# --- External systems (worker jobs) ---
EXTERNAL_PROCESSINGUNIT_URL=
EXTERNAL_PROCESSINGUNIT_API_KEY=
EXTERNAL_PROCESSINGUNIT_API_SECRET=
EXTERNAL_COMPLIANCE_URL=
EXTERNAL_COMPLIANCE_API_KEY=
EXTERNAL_COMPLIANCE_EXTERNAL_CLIENT_ID=
EXTERNAL_COMPLIANCE_EXTERNAL_CLIENT_NAME=
EXTERNAL_COMPLIANCE_EXTERNAL_CLIENT_CODE=
