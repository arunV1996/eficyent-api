<!DOCTYPE html>
<html lang="en">
<head>





<title>Payment Invoice</title>
<!-- PDF-ONLY: table layout + inline CSS + embedded logo. No external CSS or media queries. -->



</head>

<body style="margin:0;padding:0;background:#edeef0;color:#25292e;font-family:Arial,Helvetica,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin:0;padding:0;background:#edeef0;border-collapse:collapse;table-layout:fixed;">
  <tr>
    <td align="left"  style="padding:20px 12px;background:#edeef0;vertical-align:top;">

      

      <table width="600" cellpadding="0" cellspacing="0" border="0"  style="width:100%;max-width:600px;margin:0 auto;background:#ffffff;border-collapse:collapse;table-layout:fixed;">
        <tr>
          <td  style="padding:26px 28px 24px;background:#ffffff;">

            
