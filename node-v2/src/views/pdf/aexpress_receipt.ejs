                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td style="font-size:10.5px;line-height:16px;font-weight:500;color:#25292e;"><%= invoice_details.sender_address || '--' %></td></tr></table>
                    </td></tr>
                  </table>
                </td>

                <td width="50%" valign="top" class="stack-column stack-gap" style="width:50%;padding:0 0 0 18px;vertical-align:top;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td style="font-size:10.5px;line-height:15px;font-weight:500;letter-spacing:1px;color:#4e6d8c;">BENEFICIARY DETAILS</td></tr></table>
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td style="height:8px;line-height:8px;font-size:8px;">&nbsp;</td></tr></table>
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;border-top:1px solid #dfe2e5;">
                    <tr><td style="padding:11px 0 0;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td style="font-size:8.5px;line-height:12px;font-weight:500;letter-spacing:.8px;color:#9198a0;">NAME</td></tr></table>
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td style="font-size:10.5px;line-height:16px;font-weight:500;color:#25292e;"><%= invoice_details.beneficiary_name || '--' %></td></tr></table>
                    </td></tr>
                    <tr><td style="padding:9px 0 0;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td style="font-size:8.5px;line-height:12px;font-weight:500;letter-spacing:.8px;color:#9198a0;">COUNTRY</td></tr></table>
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td style="font-size:10.5px;line-height:16px;font-weight:500;color:#25292e;"><%= invoice_details.beneficiary_country || '--' %></td></tr></table>
                    </td></tr>
                    <tr><td style="padding:9px 0 0;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td style="font-size:8.5px;line-height:12px;font-weight:500;letter-spacing:.8px;color:#9198a0;">ADDRESS</td></tr></table>
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td style="font-size:10.5px;line-height:16px;font-weight:500;color:#25292e;"><%= invoice_details.beneficiary_address || '--' %></td></tr></table>
                    </td></tr>
                  </table>
                </td>
              </tr>
            </table>

            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td style="height:19px;line-height:19px;font-size:19px;">&nbsp;</td></tr></table>

            
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td style="font-size:10.5px;line-height:15px;font-weight:500;letter-spacing:1px;color:#4e6d8c;">CREDIT TO BANK ACCOUNT</td></tr></table>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td style="height:8px;line-height:8px;font-size:8px;">&nbsp;</td></tr></table>

            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
              <tr><td colspan="2" style="border-top:1px solid #dfe2e5;height:1px;line-height:1px;font-size:1px;">&nbsp;</td></tr>
               <% if(invoice_details.bank_name != "") { %>
              <tr>
                <td style="padding:10px 8px 0 0;font-size:11.5px;line-height:18px;color:#818892;">Bank Name</td>
                <td align="right" style="padding:10px 0 0 8px;font-size:11.5px;line-height:18px;font-weight:500;color:#34383d;text-align:right;"><%= invoice_details.bank_name || '--' %></td>
              </tr>
              <% } %>
              <tr>
                <td style="padding:4px 8px 0 0;font-size:11.5px;line-height:18px;color:#818892;">Account Number</td>
                <td align="right" style="padding:4px 0 0 8px;font-size:10px;line-height:17px;font-weight:500;color:#34383d;font-family:monospace;text-align:right;"><%= invoice_details.account_number || '--' %></td>
              </tr>
               <% if(invoice_details.bank_code != "") { %>
              <tr>
                <td style="padding:4px 8px 0 0;font-size:11.5px;line-height:18px;color:#818892;">Bank Code</td>
                <td align="right" style="padding:4px 0 0 8px;font-size:10px;line-height:17px;color:#34383d;font-family:monospace;text-align:right;"><%= invoice_details.bank_code || '--' %></td>
              </tr>
              <% } %>
               <% if(invoice_details.routing_number != "") { %>
              <tr>
                <td style="padding:4px 8px 0 0;font-size:11.5px;line-height:18px;color:#818892;">Routing Number</td>
                <td align="right" style="padding:4px 0 0 8px;font-size:10px;line-height:17px;color:#34383d;font-family:monospace;text-align:right;"><%= invoice_details.routing_number || '--' %></td>
              </tr>
               <% } %>
            </table>

            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td style="height:20px;line-height:20px;font-size:20px;">&nbsp;</td></tr></table>

            
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
              <tr>
                <td style="border-left:3px solid #f5a800;background:#f6f7f8;padding:13px 13px 13px 12px;font-size:9.5px;line-height:16px;color:#5d646d;">
                  The sender confirms that all printed information is correct and will not hold A-Express Remit liable for any incorrect information or discrepancies in the amount paid. The sender declares they are not acting on behalf of a beneficial owner. Please check all entries on this receipt before leaving the counter, as no claims will be accepted thereafter. Service charges are non-refundable.
                </td>
              </tr>
            </table>

            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td style="height:20px;line-height:20px;font-size:20px;">&nbsp;</td></tr></table>

            
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
              <tr>
                <td style="border-top:1px solid #dfe2e5;height:1px;line-height:1px;font-size:1px;">&nbsp;</td>
              </tr>
              <tr>
                <td  align="center" style="padding:13px 0 0;text-align:center;font-size:8.5px;line-height:14px;color:#7f8791;">
                  A-Express Remit Pte Ltd | 304 Orchard Road #02-28, Lucky Plaza, Singapore 238863 | www.aexpressremit.com<br>
                  A-Express Remit Pte Ltd is registered in Singapore (UEN 200515870C) and is regulated as a remittance business by the Monetary Authority of Singapore. This is a computer-generated invoice; contact us at remit@aexpressremit.com with any query about this transaction.
                </td>
              </tr>
            </table>

          </td>
        </tr>
      </table>

      

    </td>
  </tr>
</table>

</body>
</html>

