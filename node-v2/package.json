{
    "name": "eficyent-api-v2",
    "version": "0.1.0",
    "private": true,
    "description": "Restructured Node.js API for Eficyent (pilot module: auth). See README.md.",
    "main": "dist/app.js",
    "scripts": {
        "dev": "nodemon --watch src --ext ts --exec ts-node src/app.ts",
        "build": "tsc",
        "start": "node dist/app.js",
        "migrate": "sequelize-cli db:migrate",
        "db:migrate:undo": "sequelize-cli db:migrate:undo",
        "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all"
    },
    "dependencies": {
        "@node-rs/argon2": "^2.0.2",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "express-rate-limit": "^7.4.1",
        "express-validator": "^7.2.0",
        "helmet": "^8.0.0",
        "hpp": "^0.2.3",
        "i18n": "^0.15.1",
        "moment": "^2.30.1",
        "moment-timezone": "^0.5.46",
        "mysql2": "^3.11.5",
        "sequelize": "^6.37.5"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/hpp": "^0.2.6",
        "@types/i18n": "^0.13.12",
        "@types/node": "^20.17.9",
        "nodemon": "^3.1.7",
        "sequelize-cli": "^6.6.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.3"
    }
}
