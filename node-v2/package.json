{
    "name": "eficyent-api-v2",
    "version": "0.1.0",
    "private": true,
    "description": "Restructured Node.js API for Eficyent (pilot module: auth). See README.md.",
    "main": "dist/app.js",
    "scripts": {
        "dev": "nodemon --watch src --ext ts --exec ts-node src/app.ts",
        "build": "tsc && cp -r src/locales dist/ && cp -r src/views dist/",
        "start": "node dist/app.js",
        "migrate": "sequelize-cli db:migrate",
        "db:migrate:undo": "sequelize-cli db:migrate:undo",
        "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1086.0",
        "@aws-sdk/s3-request-presigner": "^3.1086.0",
        "@types/ejs": "^3.1.5",
        "@types/multer": "^2.2.0",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.80.2",
        "cors": "^2.8.5",
        "currency-symbol-map": "^5.1.0",
        "decimal.js": "^10.6.0",
        "dotenv": "^16.4.5",
        "ejs": "^6.0.1",
        "exceljs": "^4.4.0",
        "express": "^4.21.1",
        "express-rate-limit": "^7.4.1",
        "express-validator": "^7.2.0",
        "helmet": "^8.0.0",
        "hpp": "^0.2.3",
        "i18n": "^0.15.1",
        "ioredis": "^5.11.1",
        "moment": "^2.30.1",
        "moment-timezone": "^0.5.46",
        "morgan": "^1.11.0",
        "multer": "^2.2.0",
        "mysql2": "^3.11.5",
        "nodemailer": "^9.0.3",
        "otpauth": "^9.5.1",
        "puppeteer": "^25.3.0",
        "qrcode": "^1.5.4",
        "rotating-file-stream": "^3.2.9",
        "sequelize": "^6.37.5"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/hpp": "^0.2.6",
        "@types/i18n": "^0.13.12",
        "@types/morgan": "^1.9.10",
        "@types/node": "^20.17.9",
        "@types/nodemailer": "^8.0.1",
        "@types/qrcode": "^1.5.6",
        "nodemon": "^3.1.7",
        "sequelize-cli": "^6.6.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.3"
    }
}
